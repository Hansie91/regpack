<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>dev.regpack</groupId>
    <artifactId>regpack</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>
  <artifactId>regpack-app</artifactId>
  <name>regpack-app</name>
  <description>Application: roles, configuration and entry points</description>
  <dependencies>
    <dependency><groupId>dev.regpack</groupId><artifactId>regpack-model</artifactId></dependency>
    <dependency><groupId>dev.regpack</groupId><artifactId>regpack-ports</artifactId></dependency>
    <dependency><groupId>dev.regpack</groupId><artifactId>regpack-pack</artifactId></dependency>
    <dependency><groupId>dev.regpack</groupId><artifactId>regpack-inmemory</artifactId></dependency>
    <dependency><groupId>dev.regpack</groupId><artifactId>regpack-engine</artifactId></dependency>
    <dependency><groupId>dev.regpack</groupId><artifactId>regpack-testkit</artifactId><scope>test</scope></dependency>
  </dependencies>
  <build>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
      </resource>
      <!-- the bundled sample pack: copied byte for byte (no filtering), because its bytes must equal CHECKSUMS -->
      <resource>
        <directory>${maven.multiModuleProjectDirectory}/packs/sample.s0</directory>
        <targetPath>packs/sample.s0</targetPath>
        <filtering>false</filtering>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration>
          <archive>
            <manifest>
              <mainClass>dev.regpack.app.Main</mainClass>
              <addClasspath>true</addClasspath>
              <classpathLayoutType>custom</classpathLayoutType>
              <customClasspathLayout>$${artifact.artifactId}.$${artifact.extension}</customClasspathLayout>
              <addDefaultImplementationEntries>true</addDefaultImplementationEntries>
            </manifest>
          </archive>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.cyclonedx</groupId>
        <artifactId>cyclonedx-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>sbom</id>
            <phase>package</phase>
            <goals><goal>makeBom</goal></goals>
            <!-- explicit, so that the -DincludeTestScope=true of the aggregate licence run cannot leak test components into the shipped SBOM -->
            <configuration><includeTestScope>false</includeTestScope></configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <artifactId>maven-assembly-plugin</artifactId>
        <configuration>
          <descriptors><descriptor>src/assembly/dist.xml</descriptor></descriptors>
          <appendAssemblyId>true</appendAssemblyId>
          <tarLongFileMode>posix</tarLongFileMode>
        </configuration>
        <executions>
          <execution><id>dist</id><phase>package</phase><goals><goal>single</goal></goals></execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
