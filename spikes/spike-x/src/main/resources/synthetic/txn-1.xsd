      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>
  <xs:complexType name="rate_type">
    <xs:simpleContent>
      <xs:extension base="percent_decimal">
        <xs:attribute name="rate_basis" type="basis_kind" use="required"/>
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>
  <xs:complexType name="tagged_text_type">
    <xs:simpleContent>
      <xs:extension base="label_text">
        <xs:attribute name="source_tag" type="tag_pattern" use="optional"/>
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>
  <xs:complexType name="versioned_code_type">
    <xs:simpleContent>
      <xs:extension base="code_pattern">
        <xs:attribute name="version_label" type="version_pattern" use="optional"/>
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>
  <xs:complexType name="graded_text_type">
    <xs:simpleContent>
      <xs:extension base="long_text">
        <xs:attribute name="grade_mark" type="grade_kind" use="optional"/>
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>

  <!-- ===================== the header block and the transaction record ===================== -->
  <xs:complexType name="header_type">
    <xs:sequence>
      <xs:element name="message_id" type="xs:string"/>
      <xs:element name="created_at" type="xs:dateTime"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="record_type">
    <xs:sequence>

      <!-- identification: f01 to f04 -->
      <xs:element name="marking">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="f01_record_ref" type="ref_pattern"/>
            <xs:element name="f02_revision_no" type="xs:unsignedShort"/>
            <xs:element name="f03_batch_slot" type="fixed_text" minOccurs="0"/>
            <xs:element name="f04_origin_label" type="origin_kind" minOccurs="0"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>

      <!-- buyer side: f05 to f13 -->
      <xs:element name="buyer_side">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="f05_party_kind" type="party_kind"/>
            <xs:element name="identity">
              <xs:complexType>
                <xs:choice>
                  <xs:element name="person">
                    <xs:complexType>
                      <xs:sequence>
                        <xs:element name="f06_given_name" type="name_text"/>
                        <xs:element name="f07_family_name" type="name_text"/>
                        <xs:element name="f08_birth_date" type="xs:date"/>
                      </xs:sequence>
                    </xs:complexType>
                  </xs:element>
                  <xs:element name="organisation">
                    <xs:complexType>
                      <xs:sequence>
                        <xs:element name="f09_org_code" type="org_pattern"/>
                        <xs:element name="f10_org_label" type="label_text"/>
                      </xs:sequence>
                    </xs:complexType>
                  </xs:element>
                </xs:choice>
              </xs:complexType>
            </xs:element>
            <xs:element name="f11_zone" type="zone_code" minOccurs="0"/>
            <xs:element name="f12_contact_tag" type="tagged_text_type" minOccurs="0"/>
            <xs:element name="f13_reference_note" type="note_text" minOccurs="0"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>

      <!-- seller side: f14 to f22 -->
      <xs:element name="seller_side">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="f14_party_kind" type="party_kind"/>
            <xs:element name="identity">
              <xs:complexType>
                <xs:choice>
                  <xs:element name="person">
                    <xs:complexType>
                      <xs:sequence>
                        <xs:element name="f15_given_name" type="name_text"/>
                        <xs:element name="f16_family_name" type="name_text"/>
                        <xs:element name="f17_birth_date" type="xs:date"/>
                      </xs:sequence>
                    </xs:complexType>
                  </xs:element>
                  <xs:element name="organisation">
                    <xs:complexType>
                      <xs:sequence>
                        <xs:element name="f18_org_code" type="org_pattern"/>
                        <xs:element name="f19_org_label" type="label_text"/>
                      </xs:sequence>
                    </xs:complexType>
                  </xs:element>
                </xs:choice>
              </xs:complexType>
            </xs:element>
            <xs:element name="f20_zone" type="zone_code" minOccurs="0"/>
            <xs:element name="f21_contact_tag" type="tagged_text_type" minOccurs="0"/>
            <xs:element name="f22_reference_note" type="note_text" minOccurs="0"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>

      <!-- transmission: f23 to f25 -->
      <xs:element name="transmission" minOccurs="0">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="f23_forwarder_label" type="label_text"/>
            <xs:element name="f24_forwarded_at" type="xs:dateTime" minOccurs="0"/>
            <xs:element name="f25_route_tag" type="tag_pattern" minOccurs="0"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>

      <!-- trade details: f26 to f37 -->
      <xs:element name="trade_details">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="f26_trade_time" type="xs:dateTime"/>
            <xs:element name="f27_venue" type="venue_code"/>
            <xs:element name="price">
              <xs:complexType>
                <xs:choice>
                  <xs:element name="f28_price_amount" type="money_amount_type"/>
                  <xs:element name="f29_price_rate" type="rate_type"/>
                  <xs:element name="f30_price_pending" type="xs:boolean"/>
                </xs:choice>
              </xs:complexType>
            </xs:element>
            <xs:element name="f31_quantity" type="quantity_type"/>
            <xs:element name="f32_side" type="side_marker"/>
            <xs:element name="f33_capacity" type="capacity_kind"/>
            <xs:element name="f34_settle_date" type="xs:date" minOccurs="0"/>
            <xs:element name="f35_notional" type="notional_decimal" minOccurs="0"/>
            <xs:element name="f36_settle_style" type="settle_style" minOccurs="0"/>
            <xs:element name="f37_trade_note" type="note_text" minOccurs="0"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>

      <!-- instrument: f38 to f46, with the first repeating group -->
      <xs:element name="instrument">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="f38_instrument_ref" type="instrument_pattern"/>
            <xs:element name="f39_category" type="category_code"/>
            <xs:element name="f40_label" type="label_text" minOccurs="0"/>
            <xs:element name="f41_issue_date" type="xs:date" minOccurs="0"/>
            <xs:element name="alias" maxOccurs="unbounded">
              <xs:complexType>
                <xs:sequence>
                  <xs:element name="f42_alias_value" type="short_text"/>
                  <xs:element name="f43_alias_scheme" type="code_pattern"/>
                </xs:sequence>
              </xs:complexType>
            </xs:element>
            <xs:element name="f44_listing_flag" type="xs:boolean" minOccurs="0"/>
            <xs:element name="f45_digest_code" type="digest_pattern" minOccurs="0"/>
            <xs:element name="f46_remark" type="note_text" minOccurs="0"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>

      <!-- derivative fields: f47 to f54, with the second repeating group -->
      <xs:element name="derivative" minOccurs="0">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="f47_expiry_date" type="xs:date"/>
            <xs:element name="f48_strike" type="money_amount_type" minOccurs="0"/>
            <xs:element name="f49_option_style" type="option_style" minOccurs="0"/>
            <xs:element name="underlying" maxOccurs="unbounded">
              <xs:complexType>
                <xs:sequence>
                  <xs:element name="f50_underlying_ref" type="instrument_pattern"/>
                  <xs:element name="f51_underlying_weight" type="ratio_decimal"/>
                </xs:sequence>
              </xs:complexType>
            </xs:element>
            <xs:element name="f52_delivery_kind" type="delivery_kind" minOccurs="0"/>
            <xs:element name="f53_barrier_level" type="strike_decimal" minOccurs="0"/>
            <xs:element name="f54_contract_ref" type="versioned_code_type" minOccurs="0"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>

      <!-- decision maker: f55 to f58 -->
      <xs:element name="decision_maker" minOccurs="0">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="f55_decision_role" type="decision_role"/>
            <xs:element name="f56_person_link" type="linkage_pattern" minOccurs="0"/>
            <xs:element name="f57_decision_label" type="name_text" minOccurs="0"/>
            <xs:element name="f58_decision_tag" type="tagged_text_type" minOccurs="0"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>

      <!-- execution: f59 to f61 -->
      <xs:element name="execution" minOccurs="0">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="f59_exec_role" type="exec_role"/>
            <xs:element name="f60_exec_link" type="linkage_pattern" minOccurs="0"/>
            <xs:element name="f61_exec_label" type="graded_text_type" minOccurs="0"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>

      <!-- stance: f62 -->
      <xs:element name="f62_stance" type="stance_kind" minOccurs="0"/>

      <!-- other flags: f63 to f65 -->
      <xs:element name="flags" minOccurs="0">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="f63_late_marker" type="xs:boolean" minOccurs="0"/>
            <xs:element name="f64_extra_kind" type="extra_kind" minOccurs="0"/>
            <xs:element name="f65_comment" type="note_text" minOccurs="0"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>

    </xs:sequence>
  </xs:complexType>

  <!-- ===================== the file: a header block, then a set of transactions ===================== -->
  <xs:complexType name="file_type">
    <xs:sequence>
      <xs:element name="file_header" type="header_type"/>
      <xs:element name="transactions">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="transaction_record" type="record_type" maxOccurs="unbounded"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>

  <xs:element name="transaction_file" type="file_type"/>
</xs:schema>
